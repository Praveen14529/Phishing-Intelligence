# Copy this file to .env and add your own keys if desired.
# Keep .env private; never commit it.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=phishing_intelligence

# VirusTotal (https://virustotal.com → free signup → API Key)
VIRUSTOTAL_API_KEY=

# Google Safe Browsing (https://console.cloud.google.com → enable Safe Browsing API)
GOOGLE_SAFE_BROWSING_API_KEY=

# URLScan.io (https://urlscan.io → free signup → API Key)
URLSCAN_API_KEY=

# AbuseIPDB (https://abuseipdb.com → free signup → API Key)
ABUSEIPDB_API_KEY=

# URLhaus & OpenPhish need NO API keys — used automatically

# Performance
REQUEST_TIMEOUT=10
DNS_CONCURRENCY=20
MAX_DOMAIN_VARIANTS=50
